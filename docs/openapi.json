  "components": {
    "schemas": {
      "Body_create_item_api_items_post": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "photo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Photo"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "mark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mark"
          },
          "private_mark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Private Mark"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "category",
          "color",
          "location",
          "photo"
        ],
        "title": "Body_create_item_api_items_post"
      },
      "EventIn": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Event Id"
          },
          "device_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Device Id"
          },
          "kind": {
            "type": "string",
            "const": "deposit",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "device_id",
          "kind"
        ],
        "title": "EventIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchIn": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Query"
          },
          "broaden": {
            "type": "boolean",
            "title": "Broaden",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
